# Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Leave empty to use built-in robust local mock store)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-with-minimum-32-chars-in-production
JWT_EXPIRES_IN=7d

# Optional External Integrations
# GitHub Personal Access Token (Increases rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Optional AI Assistant API Key
AI_PROVIDER=mock
AI_API_KEY=
